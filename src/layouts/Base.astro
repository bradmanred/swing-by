---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import CookieBar from '../components/CookieBar.astro';
import AffiliateBanner from '../components/AffiliateBanner.astro';
// noindex keeps a page out of search results. image is the picture shown when the page is shared (a path on this site or a full
// address; defaults to the Swing By card). jsonLd is structured data for search engines, as one object or a list of them.
interface Props { title: string; description?: string; current?: string; analytics?: boolean; fullTitle?: string; noindex?: boolean; image?: string; jsonLd?: object | object[] }
const { title, description = 'Find playgrounds near you, and see the toilets, baby change, equipment and entry costs before you go. Every playground is checked against official council and operator sources.', current, analytics = true, fullTitle, noindex = false, image = '/og-default.png', jsonLd } = Astro.props;
const nav = [
  ['/', 'Find'],
  ['/road-trips/', 'Road trips'],
  ['/memberships/', 'Memberships'],
  ['/my-parks/', 'My parks'],
];
const full = fullTitle ?? (title === 'Swing By' ? title : `${title} | Swing By`);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL(image, Astro.site).href;
// "<" is escaped so nothing in the data can end the script tag early.
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Pages served straight from static assets skip the Worker's www redirect (wrangler.jsonc run_worker_first),
        so send www visitors to the bare domain here, before Analytics runs. A Cloudflare Redirect Rule (README)
        does this as a proper 301 before the page loads; this covers anything it misses. */}
    <script is:inline>if(location.hostname==='www.swing-by.co.uk')location.replace('https://swing-by.co.uk'+location.pathname+location.search+location.hash)</script>
    <title>{full}</title>
    {analytics && <Analytics />}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content="Swing By" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Baloo+2:wght@700;800&family=Bricolage+Grotesque:opsz,wght@12..96,800&display=swap" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {analytics && <CookieBar />}
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">
          <svg width="40" height="40" viewBox="0 0 36 36" aria-hidden="true"><path d="M5 32 L11 6 H25 L31 32" fill="none" stroke="#1E6B4F" stroke-width="3" stroke-linecap="round"/><path d="M15 6 V21 M21 6 V21" stroke="#1B2A22" stroke-width="1.6"/><rect x="13" y="21" width="10" height="3.5" rx="1.5" fill="#B5651D"/></svg>
          <span>Swing By</span>
        </a>
        <nav class="nav" aria-label="Main">
          <ul>
            {nav.map(([href, label]) => (
              <li><a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <div class="wrap stack"><slot /></div>
    </main>
    {/* Partner slot: Amazon Associates links (see AffiliateBanner). */}
    <aside class="partner-slot wrap" aria-label="Sponsored link">
      <AffiliateBanner />
    </aside>
    <footer class="site-footer">
      <div class="wrap">
        <p>Always check equipment before children use it. If something is dangerous, report it to the council or operator that runs the playground. In an emergency, call 999.</p>
        <p>Playground details come from council and operator websites, and OpenStreetMap. Places marked "Unverified" have not been checked yet. <a href="/about/">About our data</a> · <a href="/playgrounds/in/">Browse by area</a> · <a href="/playgrounds/">All playgrounds A to Z</a> · <a href="/search/">Advanced search</a></p>
        <p>Swing By is free and has no paywall. If it's helped your family, you can <a href="https://paypal.me/bradsmithpaypal" rel="noopener" target="_blank">chip in towards running costs<span class="sr-only"> (opens PayPal in a new tab)</span></a>. Entirely optional, and thank you.</p>
        <p>Map data ©<a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>.{analytics && <> · <button class="linkish" type="button" id="cookie-settings">Cookie settings</button></>}</p>
      </div>
    </footer>
  </body>
</html>
