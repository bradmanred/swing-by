---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import CookieBar from '../components/CookieBar.astro';
interface Props { title: string; description?: string; current?: string; analytics?: boolean }
const { title, description = 'Find a playground worth the trip. Checked against council and operator websites.', current, analytics = true } = Astro.props;
const nav = [
  ['/', 'Find'],
  ['/road-trips/', 'Road trips'],
  ['/memberships/', 'Memberships'],
  ['/my-parks/', 'My parks'],
];
const full = title === 'Swing By' ? title : `${title} | Swing By`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    {analytics && <Analytics />}
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Baloo+2:wght@700;800&family=Bricolage+Grotesque:opsz,wght@12..96,800&display=swap" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {analytics && <CookieBar />}
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">
          <svg width="40" height="40" viewBox="0 0 36 36" aria-hidden="true"><path d="M5 32 L11 6 H25 L31 32" fill="none" stroke="#1E6B4F" stroke-width="3" stroke-linecap="round"/><path d="M15 6 V21 M21 6 V21" stroke="#1B2A22" stroke-width="1.6"/><rect x="13" y="21" width="10" height="3.5" rx="1.5" fill="#B5651D"/></svg>
          <span>Swing By</span>
        </a>
        <form class="site-search" role="search" action="/search/" method="get">
          <label for="site-q" class="sr-only">Search playgrounds and pages</label>
          <input id="site-q" name="q" type="search" placeholder="Search parks, towns…" autocomplete="off" enterkeyhint="search" />
          <button class="btn" type="submit"><span aria-hidden="true">🔍</span><span class="sr-only">Search</span></button>
        </form>
        <nav class="nav" aria-label="Main">
          <ul>
            {nav.map(([href, label]) => (
              <li><a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <div class="wrap stack"><slot /></div>
    </main>
    {/* Advert slot. Swap the placeholder for the AdSense unit once there's a publisher ID and a cookie consent banner. */}
    <aside class="ad-slot wrap" aria-label="Advertisement">
      <div class="ad-box" data-ad-slot="banner">
        <span>Advertisement</span>
      </div>
    </aside>
    <footer class="site-footer">
      <div class="wrap">
        <p>Always check equipment before children use it. If something is dangerous, report it to the council or operator that runs the playground. In an emergency, call 999.</p>
        <p>Playground details come from council and operator websites. Places marked "Unverified" have not been checked yet. <a href="/about/">About our data</a> · <a href="/playgrounds/">All playgrounds A to Z</a></p>
        <p>Map data © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>.{analytics && <> · <button class="linkish" type="button" id="cookie-settings">Cookie settings</button></>}</p>
      </div>
    </footer>
  </body>
</html>
