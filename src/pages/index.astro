---
import Base from '../layouts/Base.astro';
import { allParks, clientPark, ICON, km, L, regions } from '../lib/parks';
import { cardHTML, fmtMiles } from '../lib/card';

const parks = await allParks();
const data = parks.map(clientPark);
const towns = regions.flatMap((r) => r.towns.map((t) => ({ ...t, r: r.id })));
const start = towns[0]; // St Albans: Hertfordshire is the launch region
const near = data
  .map((p) => ({ p, d: km(start, p) }))
  .sort((a, b) => a.d - b.d);
// Comes straight from the playground files, so it stays right as playgrounds are added.
const total = data.length;
// Equipment and facility filters, most common first: the 20 that the most playgrounds have are shown, the next 20
// go under "More filters". Counted from the playground files, so the order keeps up as playgrounds are added.
// A filter only shows once a playground has it.
const FILTER_LABEL: Record<string, string> = {
  wp: 'Splash play', cl: 'Climbing', rb: 'Roundabouts', tp: 'Trampolines', ss: 'See-saws', bb: 'Balance beams',
};
const ranked = Object.keys(ICON)
  .map((k) => ({ k, i: ICON[k], l: FILTER_LABEL[k] ?? L.equipment[k] ?? L.access[k] ?? L.facilities[k], n: data.filter((p) => p.f.includes(k)).length }))
  .filter((x) => x.l && x.n > 0)
  .sort((a, b) => b.n - a.n || a.l.localeCompare(b.l, 'en-GB'));
// Always in the top 20, however few playgrounds have it (it's what some families travel for).
const PINNED = ['tr'];
// Moved into the top 20 from April to September, while splash parks are on, by the page script below (visitor's date).
const SUMMER = 'wp';
const loves = ranked.slice(0, 20);
for (const k of PINNED) {
  const item = ranked.find((x) => x.k === k);
  if (!item || loves.includes(item)) continue;
  const drop = loves.findLastIndex((x) => !PINNED.includes(x.k));
  if (drop >= 0) loves.splice(drop, 1);
  loves.push(item);
}
const moreLoves = ranked.filter((x) => !loves.includes(x)).slice(0, 20);
const paidCount = data.filter((p) => p.pay).length;
const memberCount = data.filter((p) => p.m).length;
// The size filter is hidden until enough playgrounds have a council grade to make it useful (it was 1.3% in Nov 2026).
// The weekly "Check sizes" workflow opens an issue once graded playgrounds pass 10%; then set this back to true.
const SHOW_SIZES = false;
const sizes = (['small', 'medium', 'large'] as const).map((k) => ({ k, label: k[0].toUpperCase() + k.slice(1), n: data.filter((p) => p.s === k).length }));
// Curated photos (openly licensed, from the playground files) for the decorative hero photo. Approved parent photos
// join them in the browser once they've loaded.
const heroPhotos = parks
  .filter((p) => p.photo?.src)
  .map((p) => ({ id: p.id, name: p.name, src: p.photo!.src, credit: [p.photo!.credit, p.photo!.licence].filter(Boolean).join(', ') }));
const ages = [
  ['under-3', 'Toddlers'],
  ['3-6', '3–6'],
  ['7-12', '7–12'],
  ['teens', 'Teens'],
];
---
<Base title="Swing By" fullTitle="Swing By: find playgrounds near you, with toilets and baby change" current="/">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-intro">
      <p class="counter"><strong>{total}</strong> playgrounds and counting</p>
      <h1 id="hero-title">Where shall we play today?</h1>
      <p class="lede">Find a playground worth visiting: know what's there before you go.</p>
      <figure class="hero-photo" id="hero-photo" hidden>
        <img alt="" decoding="async" />
        <figcaption><a href="/playgrounds/"></a><span class="hero-photo-credit"></span></figcaption>
      </figure>
    </div>
    <form class="search" id="search" action="/playgrounds/" role="search" aria-label="Find playgrounds">
      <div>
        <label for="where">Town or postcode</label>
        <input id="where" data-clarity-mask="true" name="q" type="text" autocomplete="postal-code" value="" placeholder="e.g. Derby or SW1A 1AA" aria-describedby="where-hint" />
        <p class="hint" id="where-hint" aria-live="polite"></p>
        <div class="go">
          <button class="btn btn-yellow" type="button" id="locate"><span aria-hidden="true">📍</span> Near me</button>
          <button class="btn btn-red" type="submit">Let's go!</button>
        </div>
      </div>
      <fieldset>
        <legend>Who's coming?</legend>
        <div class="row">
          {ages.map(([v, l]) => <label class="chk"><input type="checkbox" name="age" value={v} /> {l}</label>)}
        </div>
      </fieldset>
      <fieldset class="which">
        <legend>Which playgrounds?</legend>
        {SHOW_SIZES && (<>
        <div class="row sizes" role="group" aria-label="Play area size" aria-describedby="size-hint">
          {sizes.map((z) => (
            <label class="chk"><input type="checkbox" name="size" value={z.k} disabled={z.n === 0} /> <span>{z.label}</span> <span class="hint">({z.n})</span></label>
          ))}
        </div>
        <p class="hint" id="size-hint">Sizes come from each council's own grading, so choosing a size only shows playgrounds that have been graded.</p>
        </>)}
        <div class="free-only">
          <label class="chk"><input type="checkbox" id="hide-unverified" name="verified" value="1" aria-describedby="unverified-hint" /> Hide unverified places</label>
          <p class="hint" id="unverified-hint">Only shows playgrounds an official source or two parents have confirmed.</p>
        </div>
        {paidCount > 0 && (
          <div class="free-only">
            <label class="chk"><input type="checkbox" id="free-only" name="free" value="1" aria-describedby="free-hint" /> Free entry only</label>
            <p class="hint" id="free-hint">Hides the {paidCount} places marked <span class="pound" aria-hidden="true">£</span><span class="sr-only">with a pound sign</span>, which charge for entry.</p>
          </div>
        )}
      </fieldset>
    </form>
  </section>


  <section class="near" aria-labelledby="near-title">
    <figure class="panel mapbox">
      <div id="map" role="region" aria-label="Map of where we think you are and the nearest playgrounds">
        <p class="nojs">The map needs JavaScript. The list of nearby parks works without it.</p>
      </div>
      <figcaption>
        <span id="where-caption"><strong>Enter your town or postcode, or tap Near me,</strong> to see playgrounds near you. Until then, here's {start.name} as an example.</span>
        <button class="btn btn-yellow" type="button" id="change">Not right? Change</button>
      </figcaption>
    </figure>
    <div class="panel" style="display:flex;flex-direction:column;gap:12px">
      <h2 id="near-title">Parks near you</h2>
      <ol class="nearlist" id="nearlist">
        {near.slice(0, 5).map(({ p, d }, i) => (
          <li><a href={`/playgrounds/${p.id}/`}><span class="num" aria-hidden="true">{i + 1}</span><span>{p.n}{p.pay && <> <span class="pound" aria-hidden="true">£</span><span class="sr-only">, paid entry</span></>}</span><span class="dist">{fmtMiles(d)}</span></a></li>
        ))}
      </ol>
      <a href="#results-title" style="margin-top:auto;font-weight:700">See all results</a>
    </div>
  </section>

  <section aria-labelledby="loves-title" class="loves">
    <h2 id="loves-title" style="margin-bottom:14px">What do they love?</h2>
    <div class="row" role="group" aria-labelledby="loves-title">
      {loves.map((x) => (
        <button class="btn" type="button" data-love={x.k} data-pin={PINNED.includes(x.k) ? '' : undefined} data-season={x.k === SUMMER ? 'summer' : undefined} data-n={x.n} aria-pressed="false"><span aria-hidden="true">{x.i}</span> {x.l}</button>
      ))}
    </div>
    {moreLoves.length > 0 && (
      <details class="more-filters" id="more-filters">
        <summary>More filters</summary>
        <div class="row" role="group" aria-label="More things they love">
          {moreLoves.map((x) => (
            <button class="btn" type="button" data-love={x.k} data-pin={PINNED.includes(x.k) ? '' : undefined} data-season={x.k === SUMMER ? 'summer' : undefined} data-n={x.n} aria-pressed="false"><span aria-hidden="true">{x.i}</span> {x.l}</button>
          ))}
        </div>
      </details>
    )}
  </section>

  <section aria-labelledby="results-title">
    <div class="results-head">
      <h2 id="results-title">Playgrounds near {start.name}, as an example</h2>
      <label style="display:flex;gap:10px;align-items:center">Sort by
        <select id="sort">
          <option value="near">Closest</option>
          <option value="fav">Your favourites</option>
          <option value="rated">Your top rated</option>
          <option value="new">Not been yet</option>
        </select>
      </label>
    </div>
    <p id="count" class="sr-only" aria-live="polite"></p>
    <p class="hint" id="unverified-note" hidden></p>
    <ul class="cards" id="cards" set:html={near.slice(0, 12).map(({ p, d }) => cardHTML(p, { dist: d })).join('')} />
    <p style="margin-top:20px"><button class="btn" type="button" id="more">Show more playgrounds</button></p>
  </section>

  <section class="tiles" aria-label="More ways to play">
    <a class="tile y" href="/road-trips/"><strong><span aria-hidden="true">🚗</span> Long drive?</strong><span>Stretch their legs within 5 minutes of the motorway, with toilets nearby.</span></a>
    <a class="tile" href="/memberships/"><strong><span aria-hidden="true">🏰</span> Got a membership?</strong><span>Make it work harder: play areas at {memberCount} places members get into free.</span></a>
    <a class="tile r" href="/my-parks/"><strong><span aria-hidden="true">🏅</span> My parks</strong><span>Your favourites, plus every park you've ticked off and rated.</span></a>
  </section>

  <section class="panel feedback" aria-labelledby="feedback-title">
    <div>
      <h2 id="feedback-title">How could we make Swing By better?</h2>
      <p>Something missing, something annoying, a place we should cover next, or a feature you'd love? Tell us. Every suggestion is read, and it's what decides what we work on.</p>
    </div>
    <form id="feedback" action="/api/feedback" method="post">
      <label for="feedback-text">Your suggestion</label>
      <textarea id="feedback-text" data-clarity-mask="true" name="message" rows="4" maxlength="1000" required aria-describedby="feedback-hint"></textarea>
      <p class="hint" id="feedback-hint">Please don't include your name, email or other personal details. Suggestions aren't shown on the site.</p>
      <div class="hp" aria-hidden="true"><label for="feedback-website">Leave this empty</label><input id="feedback-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
      <div class="row" style="align-items:center">
        <button class="btn btn-blue" type="submit">Send suggestion</button>
      </div>
      <p class="hint" id="feedback-msg" role="status"></p>
    </form>
    <p id="feedback-thanks" tabindex="-1" hidden><strong>Thank you!</strong> We've got your suggestion.</p>
  </section>

  <script type="application/json" id="parks-data" set:html={JSON.stringify({ parks: data, towns })} />
  <script type="application/json" id="hero-photos" set:html={JSON.stringify(heroPhotos)} />
  <script>
    import { startFinder } from '../scripts/finder';
    import { startFeedback } from '../scripts/feedback';
    import { summerFilters } from '../scripts/finder';
    import { startHeroPhoto, type HeroPhoto } from '../scripts/hero-photo';
    summerFilters();
    const curated = JSON.parse(document.getElementById('hero-photos')!.textContent!) as HeroPhoto[];
    startFinder({
      // Wait for approved parent photos so the hero picks once from every photo, rather than swapping after it loads.
      onPhotos: (approved, parks) => {
        const name = new Map(parks.map((p) => [p.id, p.n]));
        const fromParents = Object.entries(approved)
          .filter(([id]) => name.has(id) && !curated.some((c) => c.id === id))
          .map(([id, ph]) => ({ id, name: name.get(id)!, src: ph.url, credit: ph.credit ?? '' }));
        startHeroPhoto([...curated, ...fromParents]);
      },
    });
    startFeedback();
  </script>
</Base>
