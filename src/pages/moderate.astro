---
import Base from '../layouts/Base.astro';
import { allParks, L } from '../lib/parks';

const names = Object.fromEntries((await allParks()).map((p) => [p.id, `${p.name}, ${p.area}`]));
---
<Base title="Check photos" description="Moderation for parent photos." analytics={false}>
  <meta name="robots" content="noindex, nofollow" slot="head" />
  <div>
    <h1>Check photos</h1>
    <p style="margin-top:10px;max-width:60ch">Photos from parents, and openly licensed photos the weekly search found on Geograph and Wikimedia Commons, stay hidden until they're approved here. Reported photos come back here too.</p>
  </div>
  <div class="panel" style="max-width:720px">
    <h2 style="font-size:1.5rem">Before approving, check that the photo:</h2>
    <ul style="margin-top:10px;padding-left:20px;display:grid;gap:4px">
      <li>has <strong>no people in it at all</strong>, especially children, including in the background, reflections or at the edges</li>
      <li>shows this playground (compare with its page if unsure). Found photos can be of a nearby play area, so check the title and distance, and open the source if in doubt</li>
      <li>is recent enough to look like the playground does now</li>
      <li>has no readable car number plates, house numbers or signs with personal details</li>
      <li>isn't blurry, rude or an advert</li>
    </ul>
    <p class="hint" style="margin-top:10px">If in doubt, reject it. Rejected photos are deleted straight away.</p>
  </div>
  <form id="mod-key" class="panel" style="max-width:720px;display:grid;gap:10px">
    <label for="key">Moderator key</label>
    <input id="key" type="password" autocomplete="current-password" required style="width:100%" />
    <p class="hint">This is the MOD_TOKEN secret set on the Worker. It's kept in this browser tab only.</p>
    <button class="btn btn-blue" type="submit" style="justify-self:start">Show photos to check</button>
  </form>
  <p id="mod-msg" role="status"></p>
  <ul class="mod-list" id="mod-list"></ul>
  <section class="panel" id="vote-suggestions" hidden aria-labelledby="sugg-title" style="max-width:720px">
    <h2 id="sugg-title" style="font-size:1.5rem">Where else people want us to go</h2>
    <p class="hint" style="margin-top:6px">What families typed after choosing "Somewhere else" in the vote. Only moderators can see this.</p>
    <ol id="sugg-list" style="margin-top:10px;padding-left:22px;display:grid;gap:4px"></ol>
  </section>
  <section class="panel" id="eq-reports" hidden aria-labelledby="eq-title" style="max-width:720px">
    <h2 id="eq-title" style="font-size:1.5rem">What parents say playgrounds have</h2>
    <p class="hint" style="margin-top:6px">Answers from the "What's here" form on playground pages. Only items two parents agree on show on the site. To make them permanent, add them to the playground's file. Clear a playground's answers if they look like mischief.</p>
    <ul id="eq-list" class="facts" style="margin-top:10px"></ul>
  </section>
  <script type="application/json" id="park-labels" set:html={JSON.stringify({ ...L.equipment, ...L.access, ...L.facilities })} />
  <script type="application/json" id="park-names" set:html={JSON.stringify(names)} />
  <script>
    const names = JSON.parse(document.getElementById('park-names')!.textContent!) as Record<string, string>;
    const keyForm = document.getElementById('mod-key') as HTMLFormElement;
    const keyInput = document.getElementById('key') as HTMLInputElement;
    const msg = document.getElementById('mod-msg')!;
    const list = document.getElementById('mod-list')!;
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
    let key = '';
    try {
      key = sessionStorage.getItem('sb-mod') ?? '';
    } catch {}

    type Item = {
      id: string; park: string; status: string; credit: string | null; report_count: number; created_at: string; url: string;
      source?: string; source_url?: string | null; licence?: string | null; author?: string | null; title?: string | null; distance_m?: number | null;
    };
    const SOURCE: Record<string, string> = { geograph: 'Geograph', commons: 'Wikimedia Commons' };

    async function load() {
      msg.textContent = 'Loading…';
      list.innerHTML = '';
      const r = await fetch('/api/photos/queue', { headers: { Authorization: `Bearer ${key}` } }).catch(() => null);
      const res = r && r.headers.get('Content-Type')?.includes('json') ? await r.json() : null;
      if (!r || !r.ok) {
        msg.textContent = res?.error ?? "Couldn't load photos.";
        if (r?.status === 401) keyForm.hidden = false;
        return;
      }
      keyForm.hidden = true;
      const items: Item[] = res.photos;
      msg.textContent = items.length ? `${items.length} photo${items.length === 1 ? '' : 's'} to check.` : 'Nothing to check. All done!';
      for (const it of items) {
        const li = document.createElement('li');
        li.className = 'card';
        li.innerHTML = `<img alt="Photo sent for ${esc(names[it.park] ?? it.park)}" />
<div class="body"><h3><a href="/playgrounds/${esc(it.park)}/" target="_blank" rel="noopener">${esc(names[it.park] ?? it.park)}</a></h3>
<p class="meta">${it.status === 'reported' ? `<strong>Reported ${it.report_count} time${it.report_count === 1 ? '' : 's'}</strong> · ` : ''}${
          it.source && SOURCE[it.source]
            ? `<strong>Found on ${SOURCE[it.source]}</strong>: "${esc(it.title ?? '')}" by ${esc(it.author ?? 'unknown')}, ${esc(it.licence ?? '')}${it.distance_m != null ? `, taken ${it.distance_m} m from the pin` : ''}. ${it.source_url ? `<a href="${esc(it.source_url)}" target="_blank" rel="noopener">See it at the source</a>` : ''}`
            : `Sent by a parent ${esc(it.created_at.slice(0, 16).replace('T', ' '))}${it.credit ? ` · Credit: ${esc(it.credit)}` : ''}`
        }</p>
<div class="row"><button class="btn btn-blue" type="button" data-d="approve">Approve</button><button class="btn" type="button" data-d="reject">Reject and delete</button></div>
<p class="hint" role="status"></p></div>`;
        list.append(li);
        // Images need the key, so fetch them rather than linking directly.
        fetch(it.url, { headers: { Authorization: `Bearer ${key}` } })
          .then((x) => (x.ok ? x.blob() : null))
          .then((b) => {
            if (b) (li.querySelector('img') as HTMLImageElement).src = URL.createObjectURL(b);
          });
        li.querySelectorAll<HTMLButtonElement>('[data-d]').forEach((b) =>
          b.addEventListener('click', async () => {
            const out = li.querySelector('[role=status]')!;
            li.querySelectorAll('button').forEach((x) => (x.disabled = true));
            const rr = await fetch(`/api/photos/${it.id}/review`, {
              method: 'POST',
              headers: { Authorization: `Bearer ${key}`, 'Content-Type': 'application/json' },
              body: JSON.stringify({ decision: b.dataset.d }),
            }).catch(() => null);
            if (rr?.ok) {
              out.textContent = b.dataset.d === 'approve' ? 'Approved. It now shows on the playground page.' : 'Rejected and deleted.';
              if (b.dataset.d === 'reject') li.querySelector('img')?.remove();
            } else {
              out.textContent = "Couldn't save that. Try again.";
              li.querySelectorAll('button').forEach((x) => (x.disabled = false));
            }
          }),
        );
      }
    }

    async function loadSuggestions() {
      const r = await fetch('/api/vote/suggestions', { headers: { Authorization: `Bearer ${key}` } }).catch(() => null);
      if (!r?.ok) return;
      const { suggestions } = (await r.json()) as { suggestions: { name: string; votes: number }[] };
      const box = document.getElementById('vote-suggestions')!;
      document.getElementById('sugg-list')!.innerHTML = suggestions.length
        ? suggestions.map((s) => `<li>${esc(s.name)}: ${s.votes} vote${s.votes === 1 ? '' : 's'}</li>`).join('')
        : '<li>No suggestions yet.</li>';
      box.hidden = false;
    }

    const itemNames = JSON.parse(document.getElementById('park-labels')!.textContent!) as Record<string, string>;
    async function loadEquipment() {
      const r = await fetch('/api/equipment/confirmed', { headers: { Authorization: `Bearer ${key}` } }).catch(() => null);
      if (!r?.ok) return;
      const { parks } = (await r.json()) as { parks: { park: string; parents: number; confirmed: string[]; open: boolean | null }[] };
      const ul = document.getElementById('eq-list')!;
      ul.innerHTML = parks.length
        ? parks
            .map(
              (x) => `<li><a href="/playgrounds/${esc(x.park)}/" target="_blank" rel="noopener">${esc(names[x.park] ?? x.park)}</a>: ${x.parents} parent${x.parents === 1 ? '' : 's'}. ${
                x.open === false ? '<strong>Parents say there is no public playground.</strong> ' : x.open === true ? 'Confirmed open to everyone. ' : ''
              }${x.confirmed.length ? `Confirmed: ${x.confirmed.map((k) => esc(itemNames[k] ?? k)).join(', ')}.` : 'Nothing confirmed yet.'} <button class="linkbtn" type="button" data-clear="${esc(x.park)}">Clear answers</button></li>`,
            )
            .join('')
        : '<li>No answers from parents yet.</li>';
      ul.querySelectorAll<HTMLButtonElement>('[data-clear]').forEach((b) =>
        b.addEventListener('click', async () => {
          b.disabled = true;
          const rr = await fetch('/api/equipment/clear', { method: 'POST', headers: { Authorization: `Bearer ${key}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ park: b.dataset.clear }) }).catch(() => null);
          b.textContent = rr?.ok ? 'Cleared' : "Couldn't clear. Try again.";
          if (!rr?.ok) b.disabled = false;
        }),
      );
      document.getElementById('eq-reports')!.hidden = false;
    }

    keyForm.addEventListener('submit', (e) => {
      e.preventDefault();
      key = keyInput.value.trim();
      try {
        sessionStorage.setItem('sb-mod', key);
      } catch {}
      load();
      loadSuggestions();
      loadEquipment();
    });
    if (key) {
      load();
      loadSuggestions();
      loadEquipment();
    }
  </script>
</Base>
