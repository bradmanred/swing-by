---
import Base from '../layouts/Base.astro';
import { allParks } from '../lib/parks';

const names = Object.fromEntries((await allParks()).map((p) => [p.id, `${p.name}, ${p.area}`]));
---
<Base title="Check parent photos" description="Moderation for parent photos.">
  <meta name="robots" content="noindex, nofollow" slot="head" />
  <div>
    <h1>Check parent photos</h1>
    <p style="margin-top:10px;max-width:60ch">Photos stay hidden until they're approved here. Reported photos come back here too.</p>
  </div>
  <div class="panel" style="max-width:720px">
    <h2 style="font-size:1.5rem">Before approving, check that the photo:</h2>
    <ul style="margin-top:10px;padding-left:20px;display:grid;gap:4px">
      <li>has <strong>no people in it at all</strong>, especially children, including in the background, reflections or at the edges</li>
      <li>shows this playground (compare with its page if unsure)</li>
      <li>has no readable car number plates, house numbers or signs with personal details</li>
      <li>isn't blurry, rude or an advert</li>
    </ul>
    <p class="hint" style="margin-top:10px">If in doubt, reject it. Rejected photos are deleted straight away.</p>
  </div>
  <form id="mod-key" class="panel" style="max-width:720px;display:grid;gap:10px">
    <label for="key">Moderator key</label>
    <input id="key" type="password" autocomplete="current-password" required style="width:100%" />
    <p class="hint">This is the MOD_TOKEN secret set on the Worker. It's kept in this browser tab only.</p>
    <button class="btn btn-blue" type="submit" style="justify-self:start">Show photos to check</button>
  </form>
  <p id="mod-msg" role="status"></p>
  <ul class="mod-list" id="mod-list"></ul>
  <script type="application/json" id="park-names" set:html={JSON.stringify(names)} />
  <script>
    const names = JSON.parse(document.getElementById('park-names')!.textContent!) as Record<string, string>;
    const keyForm = document.getElementById('mod-key') as HTMLFormElement;
    const keyInput = document.getElementById('key') as HTMLInputElement;
    const msg = document.getElementById('mod-msg')!;
    const list = document.getElementById('mod-list')!;
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
    let key = '';
    try {
      key = sessionStorage.getItem('sb-mod') ?? '';
    } catch {}

    type Item = { id: string; park: string; status: string; credit: string | null; report_count: number; created_at: string; url: string };

    async function load() {
      msg.textContent = 'Loading…';
      list.innerHTML = '';
      const r = await fetch('/api/photos/queue', { headers: { Authorization: `Bearer ${key}` } }).catch(() => null);
      const res = r && r.headers.get('Content-Type')?.includes('json') ? await r.json() : null;
      if (!r || !r.ok) {
        msg.textContent = res?.error ?? "Couldn't load photos.";
        if (r?.status === 401) keyForm.hidden = false;
        return;
      }
      keyForm.hidden = true;
      const items: Item[] = res.photos;
      msg.textContent = items.length ? `${items.length} photo${items.length === 1 ? '' : 's'} to check.` : 'Nothing to check. All done!';
      for (const it of items) {
        const li = document.createElement('li');
        li.className = 'card';
        li.innerHTML = `<img alt="Photo sent for ${esc(names[it.park] ?? it.park)}" />
<div class="body"><h3><a href="/playgrounds/${esc(it.park)}/" target="_blank" rel="noopener">${esc(names[it.park] ?? it.park)}</a></h3>
<p class="meta">${it.status === 'reported' ? `<strong>Reported ${it.report_count} time${it.report_count === 1 ? '' : 's'}</strong> · ` : ''}Sent ${esc(it.created_at.slice(0, 16).replace('T', ' '))}${it.credit ? ` · Credit: ${esc(it.credit)}` : ''}</p>
<div class="row"><button class="btn btn-blue" type="button" data-d="approve">Approve</button><button class="btn" type="button" data-d="reject">Reject and delete</button></div>
<p class="hint" role="status"></p></div>`;
        list.append(li);
        // Images need the key, so fetch them rather than linking directly.
        fetch(it.url, { headers: { Authorization: `Bearer ${key}` } })
          .then((x) => (x.ok ? x.blob() : null))
          .then((b) => {
            if (b) (li.querySelector('img') as HTMLImageElement).src = URL.createObjectURL(b);
          });
        li.querySelectorAll<HTMLButtonElement>('[data-d]').forEach((b) =>
          b.addEventListener('click', async () => {
            const out = li.querySelector('[role=status]')!;
            li.querySelectorAll('button').forEach((x) => (x.disabled = true));
            const rr = await fetch(`/api/photos/${it.id}/review`, {
              method: 'POST',
              headers: { Authorization: `Bearer ${key}`, 'Content-Type': 'application/json' },
              body: JSON.stringify({ decision: b.dataset.d }),
            }).catch(() => null);
            if (rr?.ok) {
              out.textContent = b.dataset.d === 'approve' ? 'Approved. It now shows on the playground page.' : 'Rejected and deleted.';
              if (b.dataset.d === 'reject') li.querySelector('img')?.remove();
            } else {
              out.textContent = "Couldn't save that. Try again.";
              li.querySelectorAll('button').forEach((x) => (x.disabled = false));
            }
          }),
        );
      }
    }

    keyForm.addEventListener('submit', (e) => {
      e.preventDefault();
      key = keyInput.value.trim();
      try {
        sessionStorage.setItem('sb-mod', key);
      } catch {}
      load();
    });
    if (key) load();
  </script>
</Base>
