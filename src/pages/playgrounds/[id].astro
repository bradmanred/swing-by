---
import Base from '../../layouts/Base.astro';
import { allParks, clientPark, looUrl, miles, toiletInfo, toiletSource, fmtDate, hoursText, km, L, regionName, ICON, type Park } from '../../lib/parks';
import { art, fmtMiles } from '../../lib/card';

export async function getStaticPaths() {
  const parks = await allParks();
  return parks.map((p) => ({ params: { id: p.id }, props: { p, parks } }));
}
const { p, parks } = Astro.props as { p: Park; parks: Park[] };
const others = parks
  .filter((x) => x.id !== p.id)
  .map((x) => ({ x, d: km(p, x) }))
  .sort((a, b) => a.d - b.d)
  .slice(0, 3);
const feats = (keys: string[], names: Record<string, string>) => keys.filter((k) => names[k]).map((k) => ({ k, label: names[k] }));
const eq = feats(p.equipment, L.equipment);
const acc = feats(p.access, L.access);
const fac = feats(p.facilities, L.facilities);
const loos = toiletInfo(p);
const dist = (m: number) => (m < 1000 ? `${Math.round(m / 10) * 10} m` : miles(m / 1000));
const bcWord = (v: boolean | null) => (v === true ? 'with baby change' : v === false ? 'no baby change' : 'baby change not known');
const spots = [
  { lat: p.lat, lng: p.lng, label: p.name, kind: 'park' },
  ...p.nearby.filter((n) => n.lat != null && n.lng != null).map((n) => ({ lat: n.lat!, lng: n.lng!, label: `${L.nearby[n.type] ?? 'Nearby'}: ${n.label}`, kind: L.nearby[n.type] ? n.type : 'other' })),
  ...others.map(({ x, d }) => ({ lat: x.lat, lng: x.lng, label: `${x.name}, ${fmtMiles(d)}${x.fee ? ', paid entry' : ''}`, kind: 'nearby', href: `/playgrounds/${x.id}/` })),
];
const fms = `https://www.fixmystreet.com/around?latitude=${p.lat}&longitude=${p.lng}`;
const dirs = `https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lng}`;
---
<Base title={p.name} description={p.description || `${p.name}, ${p.area}`}>
  <div>
    <p class="crumbs"><a href="/">Find</a> › <a href="/playgrounds/">All playgrounds</a> › {regionName(p.region)}</p>
    <h1>{p.name}</h1>
    <p style="margin-top:12px"><button type="button" class="btn fav-big" data-fav={p.id} data-name={p.name} aria-pressed="false"><span aria-hidden="true">♥</span> <span class="fav-text">Favourite</span></button></p>
    <p class="hint" id="fav-status" aria-live="polite"></p>
    <p style="margin-top:8px;font-size:1.25rem">{p.area}{p.operator && <> · Run by {p.operator}</>}</p>
  </div>
  <div class="detail">
    <div>
      <div class="panel" style="padding:0;overflow:hidden" id="photo-box" data-curated={p.photo ? 'yes' : undefined}>
        {p.photo ? (
          <figure style="margin:0"><img src={p.photo.src} alt={p.photo.alt} style="display:block;width:100%" /><figcaption class="hint" style="padding:8px 16px">Photo: {p.photo.credit}, {p.photo.licence}</figcaption></figure>
        ) : (
          <Fragment set:html={art(clientPark(p))} />
        )}
      </div>
      {!p.checked && <p class="warn" style="margin-top:20px">Unverified: these details haven't been checked against an official source yet.</p>}
      {p.membership ? (
        <p class="panel" style="margin-top:20px;box-shadow:none">{p.fee && <><span class="pound" aria-hidden="true">£</span> <strong>Paid entry.</strong> </>}{L.memberships[p.membership]} property. {p.fee ?? 'Members get in free.'}</p>
      ) : p.fee && (
        <p class="panel" style="margin-top:20px;box-shadow:none"><span class="pound" aria-hidden="true">£</span> <strong>Paid entry.</strong> {p.fee}</p>
      )}
      <section aria-labelledby="what">
        <h2 id="what" style="margin-top:24px">What's here</h2>
        <div class="prose" style="margin-top:10px">
          {p.description && <p>{p.description}</p>}
          {p.rules && <p><strong>{p.rules}</strong></p>}
        </div>
        {(eq.length > 0 || acc.length > 0 || fac.length > 0) && (
          <ul class="chips" style="margin-top:14px" aria-label="Features">
            {[...eq, ...acc, ...fac].map((f) => <li><span aria-hidden="true">{ICON[f.k]}</span> {f.label}</li>)}
          </ul>
        )}
        {p.ages.length > 0 && <p style="margin-top:12px">Best for: {p.ages.map((a) => L.ages[a]).join(', ')}.</p>}
        {p.size && <p style="margin-top:8px">Size: {L.sizes[p.size]}, as graded by {p.operator ?? 'the council'}.</p>}
      </section>
      <section aria-labelledby="hours">
        <h2 id="hours">Opening times</h2>
        <p style="margin-top:10px">{hoursText(p)} <span data-dusk></span></p>
      </section>
      <section aria-labelledby="loos">
        <h2 id="loos">Toilets</h2>
        {loos.onSite ? (
          <div class="facts" style="margin-top:10px" data-baby-change={loos.babyChange === true ? 'yes' : loos.babyChange === false ? 'no' : 'unknown'}>
            <p><span aria-hidden="true">🚻</span> Toilets here.{' '}
              {loos.babyChange === true && <><span aria-hidden="true">🍼</span> Baby change: yes.</>}
              {loos.babyChange === false && <>No baby change.</>}
              {loos.babyChange == null && (loos.mapBabyChange
                ? <>Baby change: {loos.mapBabyChange.has ? 'yes' : 'no'}, according to the <a href={looUrl(loos.mapBabyChange.loo)} rel="noopener">Toilet Map</a>.</>
                : <>Baby change not confirmed yet.</>)}
            </p>
          </div>
        ) : (
          <div class="facts" style="margin-top:10px" data-baby-change="nearby">
            <p>No toilets listed at this playground.</p>
            {loos.nearest ? (
              <ul>
                <li>Nearest public toilets: <a href={looUrl(loos.nearest)} rel="noopener">{loos.nearest.name}</a>, {dist(loos.nearest.m)} away ({bcWord(loos.nearest.babyChange)}).</li>
                {loos.nearestBabyChange && (
                  <li>Nearest with baby change: <a href={looUrl(loos.nearestBabyChange)} rel="noopener">{loos.nearestBabyChange.name}</a>, {dist(loos.nearestBabyChange.m)} away.</li>
                )}
              </ul>
            ) : loos.known && <p>We don't know of public toilets within 2 miles.</p>}
            {loos.known && <p class="hint">Straight-line distance. Toilets from the <a href={toiletSource.url} rel="noopener">Toilet Map</a> ({toiletSource.licence}); check opening times there before you rely on them.</p>}
          </div>
        )}
      </section>
      {p.nearby.length > 0 && (
        <section aria-labelledby="nearby">
          <h2 id="nearby">Parking, toilets and food</h2>
          <ul class="facts" style="margin-top:10px">
            {p.nearby.map((n) => <li><strong>{L.nearby[n.type] ?? 'Nearby'}:</strong> {n.label}{n.free && ' (free)'}</li>)}
          </ul>
        </section>
      )}
      <section aria-labelledby="src">
        <h2 id="src">Where these details come from</h2>
        <div class="prose" style="margin-top:10px">
          {p.checked && <p>Checked on {fmtDate(p.checked)} against:</p>}
          {p.sources.length > 0 ? (
            <ul>{p.sources.map((s) => <li><a href={s.url} rel="noopener">{s.label}</a></li>)}</ul>
          ) : <p>No official source yet.</p>}
          {p.notConfirmed && <p><strong>Not confirmed yet:</strong> {p.notConfirmed}</p>}
        </div>
      </section>
    </div>
    <aside class="stack" style="--gap:20px">
      <div class="panel">
        <h2 style="font-size:1.75rem">Getting there</h2>
        <p style="margin-top:10px"><a class="btn btn-yellow" href={dirs} rel="noopener">Directions in Google Maps</a></p>
        <p class="signoff">See-saw you there!</p>
      </div>
      <figure class="panel spotmap">
        <div id="park-map" role="region" aria-label={`Map of ${p.name} and what's around it`} data-spots={JSON.stringify(spots)}>
          <p class="nojs">The map needs JavaScript. Use the directions link instead.</p>
        </div>
        <figcaption>The red pin is the playground. Car parks (P), toilets and cafés from OpenStreetMap show on the map when you zoom in. Yellow pins are other playgrounds.</figcaption>
      </figure>
      <div class="panel" id="mine" data-id={p.id}>
        <h2 style="font-size:1.75rem">Been here?</h2>
        <p style="margin-top:12px"><label class="chk"><input type="checkbox" id="been" /> We've been here</label></p>
        <fieldset style="margin-top:16px">
          <legend>Your rating</legend>
          <div class="stars">
            {[1, 2, 3, 4, 5].map((n) => (
              <><input type="radio" name="rating" id={`r${n}`} value={n} /><label for={`r${n}`}><span aria-hidden="true">{'★'.repeat(n)}</span><span class="sr-only">{n} out of 5</span></label></>
            ))}
          </div>
        </fieldset>
        <p class="hint" id="mine-status" aria-live="polite" style="margin-top:10px">Saved on this device only.</p>
        <div class="photo-nudge" id="photo-nudge" hidden>
          <p><strong>Did you take a photo while you were here?</strong> A picture helps other parents see what it's like before they go.</p>
          <div class="row">
            <button class="btn btn-yellow" type="button" id="nudge-add"><span aria-hidden="true">📷</span> Add a photo</button>
            <button class="linkbtn" type="button" id="nudge-no">Not now</button>
          </div>
          <p class="hint">Only photos with no people in them, please.</p>
        </div>
      </div>
      <div class="panel">
        <h2 style="font-size:1.75rem" id="photo-title">Share a photo</h2>
        <p style="margin-top:10px">{p.photo ? 'Been recently? Help other parents see what it\'s like now.' : "We don't have a photo of this playground yet. If you've been, you can add one."}</p>
        <details class="photo-rules" style="margin-top:12px" open>
          <summary>Photo guidelines</summary>
          <ul>
            <li><strong>No people.</strong> Only share photos with nobody in them, especially children. Wait for a quiet moment.</li>
            <li>Show the playground and its equipment.</li>
            <li>Only share photos you took yourself.</li>
            <li>Avoid car number plates and house numbers.</li>
          </ul>
          <p class="hint">We check every photo before it appears, and remove any that show people. We strip the photo's hidden location details before it leaves your phone.</p>
        </details>
        <form id="photo-form" data-park={p.id} data-name={p.name} aria-labelledby="photo-title" style="margin-top:14px;display:grid;gap:12px">
          <div>
            <label for="photo-file">Photo</label>
            <input id="photo-file" name="photo" type="file" accept="image/jpeg,image/png,image/webp,image/heic" required style="display:block;margin-top:6px;max-width:100%" />
          </div>
          <label class="chk"><input type="checkbox" name="no_people" required /> There are no people in this photo</label>
          <label class="chk"><input type="checkbox" name="own_photo" required /> I took this photo and agree it can be shared under CC BY 4.0</label>
          <div>
            <label for="photo-credit">Name to credit <span class="hint">(optional)</span></label>
            <input id="photo-credit" name="credit" type="text" maxlength="60" autocomplete="nickname" placeholder="For example, Sam from Hatfield" style="display:block;width:100%;margin-top:6px" />
          </div>
          <button class="btn btn-blue" type="submit">Send photo for checking</button>
          <p class="hint" id="photo-msg" role="status"></p>
        </form>
      </div>
      <div class="panel">
        <h2 style="font-size:1.75rem">Something wrong?</h2>
        <p style="margin-top:10px">If equipment is broken or dangerous, keep children off it and tell the people who run the playground.</p>
        <p style="margin-top:12px"><a class="btn" href={fms} rel="noopener">Report it on FixMyStreet</a></p>
        <p class="hint" style="margin-top:10px">FixMyStreet sends your report to the right council. In an emergency, call 999.</p>
      </div>
      <div class="panel">
        <h2 style="font-size:1.75rem">Also nearby</h2>
        <ul class="facts" style="margin-top:10px">
          {others.map(({ x, d }) => <li><a href={`/playgrounds/${x.id}/`}>{x.name}</a>, {fmtMiles(d)}{x.fee && <>, <span class="pay-tag"><span class="pound" aria-hidden="true">£</span> paid entry</span></>}</li>)}
        </ul>
      </div>
    </aside>
  </div>
  <script>
    import { store, getMine, startFavs } from '../../scripts/store';
    startFavs();
    import { startPhotos } from '../../scripts/photos';
    startPhotos();
    import('../../scripts/map').then(({ createSpotMap }) => {
      const el = document.getElementById('park-map');
      if (el) createSpotMap(el, JSON.parse(el.dataset.spots!));
    });
    const DUSK = ['16:35', '17:25', '18:15', '20:05', '20:50', '21:20', '21:15', '20:25', '19:20', '18:15', '16:25', '15:55'];
    const d = document.querySelector('[data-dusk]');
    if (d) d.textContent = `Dusk is around ${DUSK[new Date().getMonth()]} this month.`;
    const box = document.getElementById('mine')!;
    const id = box.dataset.id!;
    const been = document.getElementById('been') as HTMLInputElement;
    const status = document.getElementById('mine-status')!;
    const cur = getMine()[id] ?? {};
    been.checked = !!cur.v;
    if (cur.r) (document.getElementById(`r${cur.r}`) as HTMLInputElement).checked = true;
    function save(msg: string) {
      const mine = getMine();
      const r = Number((box.querySelector('input[name=rating]:checked') as HTMLInputElement | null)?.value) || undefined;
      mine[id] = { ...mine[id], v: been.checked || !!r, r, t: new Date().toISOString().slice(0, 10) };
      if (r) been.checked = true;
      store.set('sb-mine', mine);
      status.textContent = `${msg} Saved on this device only.`;
    }
    // After ticking "We've been here", ask for a photo, unless they've already said not now for this playground.
    const nudge = document.getElementById('photo-nudge')!;
    const nudgeKey = `sb-nudge-${id}`;
    const showNudge = () => {
      let dismissed = false;
      try {
        dismissed = sessionStorage.getItem(nudgeKey) === 'no';
      } catch {}
      nudge.hidden = !been.checked || dismissed;
    };
    document.getElementById('nudge-add')!.addEventListener('click', () => {
      document.getElementById('photo-title')?.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      document.getElementById('photo-file')?.focus({ preventScroll: true });
      nudge.hidden = true;
    });
    document.getElementById('nudge-no')!.addEventListener('click', () => {
      try {
        sessionStorage.setItem(nudgeKey, 'no');
      } catch {}
      nudge.hidden = true;
      been.focus();
    });
    been.addEventListener('change', () => {
      save(been.checked ? 'Ticked off.' : 'Unticked.');
      showNudge();
    });
    box.querySelectorAll('input[name=rating]').forEach((r) =>
      r.addEventListener('change', () => {
        save(`Rated ${(r as HTMLInputElement).value} out of 5.`);
        showNudge();
      }),
    );
  </script>
</Base>
