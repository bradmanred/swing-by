---
// The A to Z, as a short page of regions with a link for each letter. The playgrounds themselves are on the letter
// pages (src/pages/playgrounds/in/[region]/a-z/[letter].astro), so this page stays small enough for a phone.
import Base from '../../layouts/Base.astro';
import { azLabel, azPages, azUrl, regionUrl } from '../../lib/places';
const all = await azPages();
---
<Base title="All playgrounds A to Z" description="Every playground we list, by county and region, then town A to Z.">
  <h1>All playgrounds A to Z</h1>
  <p>Every playground we list, by county or region and then by the first letter of the town or area. To search by postcode, use <a href="/">Find</a>, or <a href="/playgrounds/in/">browse by area</a>.</p>
  {all.map((r) => (
    <section aria-labelledby={`r-${r.id}`}>
      <h2 id={`r-${r.id}`}><a href={regionUrl(r.id)}>{r.name}</a> ({r.count.toLocaleString('en-GB')})</h2>
      <ul class="place-links az-letters" aria-label={`Towns and areas in ${r.name}, A to Z`}>
        {r.letters.map((l) => <li><a href={azUrl(r.id, l.key)} aria-label={`${r.name}: ${azLabel(l.key)} (${l.parks.length} playgrounds)`}>{azLabel(l.key)}</a></li>)}
      </ul>
    </section>
  ))}
</Base>
