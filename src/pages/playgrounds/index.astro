---
import Base from '../../layouts/Base.astro';
import { allParks, paidEntry, regions } from '../../lib/parks';
const parks = await allParks();
---
<Base title="All playgrounds A to Z">
  <h1>All playgrounds A to Z</h1>
  <p>Every playground we list, grouped by county and town. Places marked "Unverified" haven't been checked yet, and places marked <span class="pound" aria-hidden="true">£</span> Paid entry charge to get in.</p>
  {regions.map((r) => {
    const inR = parks.filter((p) => p.region === r.id);
    const areas = [...new Set(inR.map((p) => p.area))].sort((a, b) => a.localeCompare(b, 'en-GB'));
    return (
      <section aria-labelledby={`r-${r.id}`}>
        <h2 id={`r-${r.id}`}>{r.name} ({inR.length})</h2>
        {areas.map((a) => (
          <div style="margin-top:16px">
            <h3>{a}</h3>
            <ul>
              {inR.filter((p) => p.area === a).map((p) => (
                <li><a href={`/playgrounds/${p.id}/`}>{p.name}</a>{paidEntry(p) && <> <span class="pay-tag"><span class="pound" aria-hidden="true">£</span> Paid entry</span></>}{!p.checked && ' (Unverified)'}</li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    );
  })}
</Base>
