---
import Base from '../layouts/Base.astro';
import { allParks, km, L, paidEntry } from '../lib/parks';
import { fmtMiles } from '../lib/card';
import junctionsFile from '../data/junctions.json';

const parks = await allParks();
// About 5 minutes' drive off the junction: 3 miles in a straight line.
const RADIUS_KM = 4.8;
const rows = junctionsFile.junctions.map((j) => ({
  j,
  near: parks
    .map((p) => ({ p, d: km(j, p) }))
    .filter((x) => x.d <= RADIUS_KM)
    .sort((a, b) => Number(b.p.facilities.includes('wc')) - Number(a.p.facilities.includes('wc')) || a.d - b.d)
    .slice(0, 6),
}));
---
<Base title="Road trips" current="/road-trips/" description="Playgrounds within about 5 minutes of motorway and major road junctions.">
  <h1>Break a long drive</h1>
  <p style="max-width:60ch">Playgrounds within about 5 minutes of a motorway or major road junction, with toilets listed first. Distances are in a straight line from the junction, so check the route before you leave the motorway.</p>
  <p><label class="chk"><input type="checkbox" id="free-only" /> Free entry only</label> <span class="hint">Hides places marked <span class="pound" aria-hidden="true">£</span> Paid entry.</span></p>
  <ul class="cards">
    {rows.map(({ j, near }) => (
      <li class="card">
        <div class="body">
          <h2 style="font-size:1.75rem">{j.name}</h2>
          <p>{j.serves}</p>
          {near.length ? (
            <ul class="facts">
              {near.map(({ p, d }, i) => (
                <li data-pay={paidEntry(p) ? '' : undefined} hidden={i >= 3}><a href={`/playgrounds/${p.id}/`}>{p.name}</a>, {fmtMiles(d)}{p.facilities.includes('wc') && ', toilets'}{paidEntry(p) && <>, <span class="pay-tag"><span class="pound" aria-hidden="true">£</span> paid entry</span></>}{!p.checked && ' (Unverified)'}</li>
              ))}
            </ul>
          ) : null}
          <p class="hint none" hidden={near.length > 0}>We haven't found a {near.length ? 'free ' : ''}playground within 5 minutes of this junction yet.</p>
        </div>
      </li>
    ))}
  </ul>
  <script>
    import { store } from '../scripts/store';
    // Show up to three playgrounds per junction, leaving out paid ones when asked.
    const box = document.querySelector<HTMLInputElement>('#free-only')!;
    const apply = () => {
      document.querySelectorAll('.cards > .card').forEach((card) => {
        let shown = 0;
        card.querySelectorAll<HTMLLIElement>('.facts > li').forEach((li) => {
          const ok = !(box.checked && li.hasAttribute('data-pay')) && shown < 3;
          li.hidden = !ok;
          if (ok) shown++;
        });
        const none = card.querySelector<HTMLElement>('.none');
        if (none) none.hidden = shown > 0;
      });
    };
    box.checked = store.get<boolean>('sb-free-only', false);
    box.addEventListener('change', () => {
      store.set('sb-free-only', box.checked);
      apply();
    });
    apply();
  </script>
</Base>
