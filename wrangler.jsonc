// Cloudflare Workers settings: serves the built site from dist/ and runs worker/index.js for /api/*.
{
  "name": "swing-by",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
