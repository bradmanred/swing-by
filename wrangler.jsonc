// Cloudflare Workers settings: serves the built site from dist/ and runs worker/index.js for /api/*.
{
  "name": "swing-by",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // Keep variables set in the Cloudflare dashboard (such as GITHUB_CLIENT_ID for the content editor).
  // Without this, every deploy deletes them and the editor's GitHub sign-in breaks.
  "keep_vars": true,
  // The site's own domain. Cloudflare creates the DNS records and certificates on deploy.
  // The zone swing-by.co.uk must be in the same Cloudflare account. www redirects to the bare domain (worker/index.js)
  // only for the paths in run_worker_first below; a Redirect Rule in the Cloudflare dashboard covers the rest (README).
  "routes": [
    { "pattern": "swing-by.co.uk", "custom_domain": true },
    { "pattern": "www.swing-by.co.uk", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only these paths run worker/index.js. Everything else (CSS, scripts, images, search data, other pages) is served
    // straight from dist/, which is free and doesn't count towards the free plan's 100,000 Worker requests a day.
    // With "true" here, every file on every page view was a Worker request.
    // /playgrounds/* covers the packed playground pages and the redirects for merged, renamed and "c-" addresses.
    "run_worker_first": ["/api/*", "/playgrounds/*", "/_pages/*"]
  },
  "d1_databases": [
    // Parent photos (held for approval before they're shown), parents' reports and site feedback. Tables: db/*.sql
    {
      "binding": "PHOTOS_DB",
      "database_name": "swing-by-photos",
      "database_id": "ec6cfb8b-97cf-4f15-aa7a-3fe4e774e401"
    }
  ],
  // Branch previews (npx wrangler preview) use these settings instead of the ones above.
  // Photos, reports and feedback sent from a preview go to a separate test database, never the real ones.
  // The content editor's GitHub sign-in isn't set up on previews; use the live site for that.
  "previews": {
    "d1_databases": [
      {
        "binding": "PHOTOS_DB",
        "database_name": "swing-by-photos-preview",
        "database_id": "9c4669bf-9268-40d6-bc52-6774ed826892"
      }
    ]
  }
}
